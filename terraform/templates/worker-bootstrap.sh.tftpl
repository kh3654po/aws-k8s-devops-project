#!/usr/bin/env bash

set -euo pipefail

LOG_FILE="/var/log/k8s-worker-bootstrap.log"

exec > >(tee -a "$${LOG_FILE}") 2>&1

echo "========================================"
echo "Kubernetes ASG Worker Bootstrap"
echo "========================================"
echo "Cluster name: ${cluster_name}"
echo "Region      : ${region}"
echo "SSM param   : ${ssm_join_command_parameter}"
echo "Started at  : $(date -Is)"
echo

export DEBIAN_FRONTEND=noninteractive
export AWS_REGION="${region}"
export SSM_JOIN_COMMAND_PARAMETER="${ssm_join_command_parameter}"

echo "[1/10] Running inside cloud-init user data. Skipping cloud-init wait."

echo
echo "[2/10] Disabling swap..."

swapoff -a || true

sed -i.bak '/ swap / s/^/#/' /etc/fstab || true

echo
echo "[3/10] Configuring kernel modules and sysctl..."

cat >/etc/modules-load.d/k8s.conf <<'EOF'
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

cat >/etc/sysctl.d/k8s.conf <<'EOF'
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF

sysctl --system

echo
echo "[4/10] Installing base packages..."

apt update -y

apt install -y \
  apt-transport-https \
  ca-certificates \
  curl \
  gpg \
  unzip \
  containerd

echo
echo "[4-1/10] Installing AWS CLI v2..."

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
  -o "/tmp/awscliv2.zip"

rm -rf /tmp/aws

unzip -q /tmp/awscliv2.zip -d /tmp

/tmp/aws/install

aws --version

echo
echo "[5/10] Configuring containerd..."

mkdir -p /etc/containerd

containerd config default >/etc/containerd/config.toml

sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml

systemctl restart containerd
systemctl enable containerd

echo
echo "[6/10] Installing Kubernetes packages..."

mkdir -p /etc/apt/keyrings

curl -fsSL "https://pkgs.k8s.io/core:/stable:/${kubernetes_apt_version}/deb/Release.key" \
  | gpg --dearmor --yes -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg

cat >/etc/apt/sources.list.d/kubernetes.list <<EOF
deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${kubernetes_apt_version}/deb/ /
EOF

apt update -y

apt install -y kubelet kubeadm kubectl

apt-mark hold kubelet kubeadm kubectl

systemctl enable kubelet

echo
echo "[7/10] Configuring Kubernetes AWS provider ID..."

IMDS_TOKEN="$(curl -fsS \
  -X PUT \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" \
  http://169.254.169.254/latest/api/token)"

if [ -z "$${IMDS_TOKEN}" ]; then
  echo "Failed to retrieve IMDSv2 token."
  exit 1
fi

INSTANCE_ID="$(curl -fsS \
  -H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)"

AVAILABILITY_ZONE="$(curl -fsS \
  -H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)"

if [ -z "$${INSTANCE_ID}" ]; then
  echo "Failed to retrieve EC2 instance ID from IMDS."
  exit 1
fi

if [ -z "$${AVAILABILITY_ZONE}" ]; then
  echo "Failed to retrieve EC2 availability zone from IMDS."
  exit 1
fi

AWS_PROVIDER_ID="aws:///$${AVAILABILITY_ZONE}/$${INSTANCE_ID}"

echo "Instance ID : $${INSTANCE_ID}"
echo "AZ          : $${AVAILABILITY_ZONE}"
echo "Provider ID : $${AWS_PROVIDER_ID}"

cat >/etc/default/kubelet <<EOF
KUBELET_EXTRA_ARGS=--provider-id=$${AWS_PROVIDER_ID}
EOF

echo "Kubelet provider ID configuration:"
cat /etc/default/kubelet

echo
echo "[8/10] Checking whether this node already joined..."

if [ -f /etc/kubernetes/kubelet.conf ]; then
  echo "This node already has /etc/kubernetes/kubelet.conf."
  echo "Skipping kubeadm join."
  exit 0
fi

echo
echo "[9/10] Reading kubeadm join command from SSM Parameter Store..."

JOIN_COMMAND="$(aws ssm get-parameter \
  --region "$${AWS_REGION}" \
  --name "$${SSM_JOIN_COMMAND_PARAMETER}" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text)"

if [ -z "$${JOIN_COMMAND}" ]; then
  echo "Failed to read kubeadm join command from SSM Parameter Store."
  exit 1
fi

echo "Join command was retrieved from SSM Parameter Store."

echo
echo "[10/10] Joining Kubernetes cluster..."

$${JOIN_COMMAND}

echo
echo "Kubernetes ASG worker bootstrap completed."
echo "Provider ID: $${AWS_PROVIDER_ID}"
echo "Finished at: $(date -Is)"
echo "Log file   : $${LOG_FILE}"