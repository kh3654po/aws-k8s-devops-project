installCRDs: true
keepCRDs: true

clusterInstall: true

controller:
  replicas: {{ argo_rollouts_controller_replicas }}

  logging:
    level: info
    format: text

  resources:
    requests:
      cpu: 50m
      memory: 64Mi

    limits:
      cpu: 300m
      memory: 256Mi

  metrics:
    enabled: true

    service:
      portName: metrics
      port: 8090

    serviceMonitor:
      enabled: true

      additionalLabels:
        release: "{{ kube_prometheus_stack_release_name }}"

providerRBAC:
  enabled: true

  providers:
    istio: true

    smi: false
    ambassador: false
    awsLoadBalancerController: false
    awsAppMesh: false
    traefik: false
    apisix: false
    contour: false
    glooPlatform: false
    gatewayAPI: false

dashboard:
  enabled: false