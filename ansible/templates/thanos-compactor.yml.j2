apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ thanos_compactor_service_name }}
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: thanos-compactor

spec:
  replicas: {{ thanos_compactor_replicas }}

  selector:
    matchLabels:
      app.kubernetes.io/name: thanos-compactor

  template:
    metadata:
      labels:
        app.kubernetes.io/name: thanos-compactor

    spec:
      containers:
        - name: thanos-compactor
          image: "{{ thanos_compactor_image }}"
          imagePullPolicy: IfNotPresent

          args:
            - compact

            - --data-dir={{ thanos_compactor_data_dir }}

            - --objstore.config-file=/etc/thanos/objstore.yml

            - --http-address=0.0.0.0:{{ thanos_compactor_http_port }}

            - --retention.resolution-raw={{ thanos_compactor_retention_raw }}

            - --retention.resolution-5m={{ thanos_compactor_retention_5m }}

            - --retention.resolution-1h={{ thanos_compactor_retention_1h }}

            - --wait

          ports:
            - name: http
              containerPort: {{ thanos_compactor_http_port }}

          readinessProbe:
            httpGet:
              path: /-/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10

          livenessProbe:
            httpGet:
              path: /-/healthy
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20

          resources:
            requests:
              cpu: "{{ thanos_compactor_resources.requests.cpu }}"
              memory: "{{ thanos_compactor_resources.requests.memory }}"

            limits:
              cpu: "{{ thanos_compactor_resources.limits.cpu }}"
              memory: "{{ thanos_compactor_resources.limits.memory }}"

          volumeMounts:
            - name: objstore-config
              mountPath: /etc/thanos
              readOnly: true

            - name: data
              mountPath: "{{ thanos_compactor_data_dir }}"

      volumes:
        - name: objstore-config
          secret:
            secretName: "{{ thanos_object_storage_secret_name }}"
            items:
              - key: "{{ thanos_object_storage_secret_key }}"
                path: objstore.yml

        - name: data
          emptyDir: {}

---
apiVersion: v1
kind: Service
metadata:
  name: {{ thanos_compactor_service_name }}
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: thanos-compactor

spec:
  type: ClusterIP

  selector:
    app.kubernetes.io/name: thanos-compactor

  ports:
    - name: http
      port: {{ thanos_compactor_http_port }}
      targetPort: http