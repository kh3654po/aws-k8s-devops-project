---
apiVersion: v1
kind: Namespace
metadata:
  name: "{{ ingress_test_namespace }}"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ ingress_test_deployment_name }}"
  namespace: "{{ ingress_test_namespace }}"
  labels:
    app: "{{ ingress_test_app_label }}"

spec:
  replicas: {{ ingress_test_replicas }}

  selector:
    matchLabels:
      app: "{{ ingress_test_app_label }}"

  template:
    metadata:
      labels:
        app: "{{ ingress_test_app_label }}"

    spec:
      containers:
        - name: nginx
          image: "{{ ingress_test_image }}"
          imagePullPolicy: IfNotPresent

          ports:
            - name: http
              containerPort: 80
              protocol: TCP

          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 3
            periodSeconds: 5

          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10

          resources:
            requests:
              cpu: 50m
              memory: 64Mi

            limits:
              cpu: 100m
              memory: 128Mi

---
apiVersion: v1
kind: Service
metadata:
  name: "{{ ingress_test_service_name }}"
  namespace: "{{ ingress_test_namespace }}"
  labels:
    app: "{{ ingress_test_app_label }}"

spec:
  type: ClusterIP

  selector:
    app: "{{ ingress_test_app_label }}"

  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: http

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "{{ ingress_test_ingress_name }}"
  namespace: "{{ ingress_test_namespace }}"
  labels:
    app: "{{ ingress_test_app_label }}"

spec:
  ingressClassName: "{{ ingress_nginx_class_name }}"

  rules:
    - host: "{{ ingress_test_host }}"

      http:
        paths:
          - path: /
            pathType: Prefix

            backend:
              service:
                name: "{{ ingress_test_service_name }}"

                port:
                  number: 80