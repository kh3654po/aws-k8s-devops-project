apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ thanos_store_service_name }}
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: thanos-store

spec:
  replicas: {{ thanos_store_replicas }}

  selector:
    matchLabels:
      app.kubernetes.io/name: thanos-store

  template:
    metadata:
      labels:
        app.kubernetes.io/name: thanos-store

    spec:
      containers:
        - name: thanos-store
          image: "{{ thanos_store_image }}"
          imagePullPolicy: IfNotPresent

          args:
            - store
            - --data-dir={{ thanos_store_data_dir }}
            - --objstore.config-file=/etc/thanos/objstore.yml
            - --http-address=0.0.0.0:{{ thanos_store_http_port }}
            - --grpc-address=0.0.0.0:{{ thanos_store_grpc_port }}

          ports:
            - name: grpc
              containerPort: {{ thanos_store_grpc_port }}

            - name: http
              containerPort: {{ thanos_store_http_port }}

          readinessProbe:
            httpGet:
              path: /-/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10

          livenessProbe:
            httpGet:
              path: /-/healthy
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20

          resources:
            requests:
              cpu: "{{ thanos_store_resources.requests.cpu }}"
              memory: "{{ thanos_store_resources.requests.memory }}"

            limits:
              cpu: "{{ thanos_store_resources.limits.cpu }}"
              memory: "{{ thanos_store_resources.limits.memory }}"

          volumeMounts:
            - name: objstore-config
              mountPath: /etc/thanos
              readOnly: true

            - name: data
              mountPath: "{{ thanos_store_data_dir }}"

      volumes:
        - name: objstore-config
          secret:
            secretName: "{{ thanos_object_storage_secret_name }}"
            items:
              - key: "{{ thanos_object_storage_secret_key }}"
                path: objstore.yml

        - name: data
          emptyDir: {}

---
apiVersion: v1
kind: Service
metadata:
  name: {{ thanos_store_service_name }}
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: thanos-store

spec:
  type: ClusterIP

  selector:
    app.kubernetes.io/name: thanos-store

  ports:
    - name: grpc
      port: {{ thanos_store_grpc_port }}
      targetPort: grpc

    - name: http
      port: {{ thanos_store_http_port }}
      targetPort: http