---
apiVersion: v1
kind: ConfigMap

metadata:
  name: "{{ istio_operations_app }}-server"
  namespace: "{{ istio_operations_namespace }}"

data:
  server.py: |
    import os
    import time
    import threading

    from http.server import BaseHTTPRequestHandler
    from http.server import ThreadingHTTPServer
    from urllib.parse import urlparse
    from urllib.parse import parse_qs


    VERSION = os.getenv("VERSION", "unknown")

    flaky_count = 0
    flaky_lock = threading.Lock()


    class Handler(BaseHTTPRequestHandler):

        def write_response(self, status, body):
            payload = body.encode()

            self.send_response(status)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()

            try:
                self.wfile.write(payload)
            except BrokenPipeError:
                pass


        def do_GET(self):
            global flaky_count

            parsed = urlparse(self.path)
            path = parsed.path
            query = parse_qs(parsed.query)

            if path == "/health":
                self.write_response(200, "ok\n")
                return

            if path == "/reset-flaky":
                with flaky_lock:
                    flaky_count = 0

                self.write_response(
                    200,
                    "flaky_count=0\n"
                )
                return

            if path == "/flaky-count":
                with flaky_lock:
                    count = flaky_count

                self.write_response(
                    200,
                    f"flaky_count={count}\n"
                )
                return

            if path == "/flaky":
                with flaky_lock:
                    flaky_count += 1
                    count = flaky_count

                if count % 2 == 1:
                    self.write_response(
                        503,
                        f"version={VERSION} flaky_attempt={count}\n"
                    )
                else:
                    self.write_response(
                        200,
                        f"version={VERSION} flaky_attempt={count}\n"
                    )

                return

            if path == "/slow":
                time.sleep(3)

                self.write_response(
                    200,
                    f"version={VERSION} slow=true\n"
                )

                return

            if path == "/hold":
                seconds = float(
                    query.get(
                        "seconds",
                        ["2"]
                    )[0]
                )

                time.sleep(seconds)

                self.write_response(
                    200,
                    f"version={VERSION} hold={seconds}\n"
                )

                return

            if path == "/error":
                self.write_response(
                    500,
                    f"version={VERSION} error=true\n"
                )

                return

            self.write_response(
                200,
                f"version={VERSION} path={path}\n"
            )


        def log_message(self, format, *args):
            return


    ThreadingHTTPServer(
        ("0.0.0.0", 8080),
        Handler
    ).serve_forever()

---
apiVersion: v1
kind: ServiceAccount

metadata:
  name: "{{ istio_operations_server_service_account }}"
  namespace: "{{ istio_operations_namespace }}"

---
apiVersion: v1
kind: ServiceAccount

metadata:
  name: "{{ istio_operations_client_service_account }}"
  namespace: "{{ istio_operations_namespace }}"

---
apiVersion: v1
kind: ServiceAccount

metadata:
  name: "{{ istio_operations_unauthorized_service_account }}"
  namespace: "{{ istio_operations_namespace }}"

---
apiVersion: apps/v1
kind: Deployment

metadata:
  name: "{{ istio_operations_app }}-v1"
  namespace: "{{ istio_operations_namespace }}"

spec:
  replicas: 1

  selector:
    matchLabels:
      app: "{{ istio_operations_app }}"
      version: v1

  template:
    metadata:
      labels:
        app: "{{ istio_operations_app }}"
        version: v1

    spec:
      serviceAccountName: "{{ istio_operations_server_service_account }}"

      containers:
        - name: app
          image: python:3.13-alpine

          command:
            - python
            - /app/server.py

          env:
            - name: VERSION
              value: v1

          ports:
            - name: http
              containerPort: 8080

          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 2
            periodSeconds: 5

          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10

          resources:
            requests:
              cpu: 25m
              memory: 32Mi

            limits:
              cpu: 200m
              memory: 128Mi

          volumeMounts:
            - name: server
              mountPath: /app
              readOnly: true

      volumes:
        - name: server
          configMap:
            name: "{{ istio_operations_app }}-server"

---
apiVersion: apps/v1
kind: Deployment

metadata:
  name: "{{ istio_operations_app }}-v2"
  namespace: "{{ istio_operations_namespace }}"

spec:
  replicas: 1

  selector:
    matchLabels:
      app: "{{ istio_operations_app }}"
      version: v2

  template:
    metadata:
      labels:
        app: "{{ istio_operations_app }}"
        version: v2

    spec:
      serviceAccountName: "{{ istio_operations_server_service_account }}"

      containers:
        - name: app
          image: python:3.13-alpine

          command:
            - python
            - /app/server.py

          env:
            - name: VERSION
              value: v2

          ports:
            - name: http
              containerPort: 8080

          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 2
            periodSeconds: 5

          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10

          resources:
            requests:
              cpu: 25m
              memory: 32Mi

            limits:
              cpu: 200m
              memory: 128Mi

          volumeMounts:
            - name: server
              mountPath: /app
              readOnly: true

      volumes:
        - name: server
          configMap:
            name: "{{ istio_operations_app }}-server"

---
apiVersion: v1
kind: Service

metadata:
  name: "{{ istio_operations_service }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  selector:
    app: "{{ istio_operations_app }}"

  ports:
    - name: http
      port: 80
      targetPort: http

---
apiVersion: apps/v1
kind: Deployment

metadata:
  name: "{{ istio_operations_client_app }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  replicas: 1

  selector:
    matchLabels:
      app: "{{ istio_operations_client_app }}"

  template:
    metadata:
      labels:
        app: "{{ istio_operations_client_app }}"

    spec:
      serviceAccountName: "{{ istio_operations_client_service_account }}"

      containers:
        - name: "{{ istio_operations_client_app }}"
          image: curlimages/curl:8.12.1

          command:
            - sh
            - -c
            - sleep 2147483647

          resources:
            requests:
              cpu: 10m
              memory: 16Mi

            limits:
              cpu: 100m
              memory: 64Mi

---
apiVersion: apps/v1
kind: Deployment

metadata:
  name: "{{ istio_operations_unauthorized_client_app }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  replicas: 1

  selector:
    matchLabels:
      app: "{{ istio_operations_unauthorized_client_app }}"

  template:
    metadata:
      labels:
        app: "{{ istio_operations_unauthorized_client_app }}"

    spec:
      serviceAccountName: "{{ istio_operations_unauthorized_service_account }}"

      containers:
        - name: "{{ istio_operations_unauthorized_client_app }}"
          image: curlimages/curl:8.12.1

          command:
            - sh
            - -c
            - sleep 2147483647

          resources:
            requests:
              cpu: 10m
              memory: 16Mi

            limits:
              cpu: 100m
              memory: 64Mi

---
apiVersion: security.istio.io/v1
kind: PeerAuthentication

metadata:
  name: "{{ istio_operations_peer_authentication_name }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  selector:
    matchLabels:
      app: "{{ istio_operations_app }}"

  mtls:
    mode: STRICT

---
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy

metadata:
  name: "{{ istio_operations_authorization_policy_name }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  selector:
    matchLabels:
      app: "{{ istio_operations_app }}"

  action: ALLOW

  rules:
    - from:
        - source:
            serviceAccounts:
              - "{{ istio_operations_namespace }}/{{ istio_operations_client_service_account }}"

      to:
        - operation:
            methods:
              - GET

    - from:
        - source:
            namespaces:
              - "{{ istio_ingress_namespace }}"

      to:
        - operation:
            methods:
              - GET

---
apiVersion: networking.istio.io/v1
kind: Gateway

metadata:
  name: "{{ istio_operations_gateway_name }}"
  namespace: "{{ istio_ingress_namespace }}"

spec:
  selector:
    istio: ingressgateway

  servers:
    - port:
        number: 80
        name: http
        protocol: HTTP

      hosts:
        - "{{ istio_operations_namespace }}/{{ istio_operations_gateway_host }}"

---
apiVersion: networking.istio.io/v1
kind: VirtualService

metadata:
  name: "{{ istio_operations_ingress_virtualservice_name }}"
  namespace: "{{ istio_operations_namespace }}"

spec:
  hosts:
    - "{{ istio_operations_gateway_host }}"

  exportTo:
    - "{{ istio_ingress_namespace }}"

  gateways:
    - "{{ istio_ingress_namespace }}/{{ istio_operations_gateway_name }}"

  http:
    - match:
        - uri:
            prefix: /ops

      rewrite:
        uri: /

      route:
        - destination:
            host: "{{ istio_operations_service }}.{{ istio_operations_namespace }}.svc.cluster.local"

            port:
              number: 80