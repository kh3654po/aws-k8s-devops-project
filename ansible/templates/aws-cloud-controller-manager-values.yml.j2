---
namespace: "{{ aws_ccm_namespace }}"

image:
  repository: registry.k8s.io/provider-aws/cloud-controller-manager
  tag: "{{ aws_ccm_image_tag }}"

hostNetworking: true
dnsPolicy: Default

nodeSelector:
  node-role.kubernetes.io/control-plane: ""

tolerations:
  - key: node.cloudprovider.kubernetes.io/uninitialized
    value: "true"
    effect: NoSchedule

  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

  - key: node-role.kubernetes.io/master
    operator: Exists
    effect: NoSchedule

  - key: node.kubernetes.io/not-ready
    operator: Exists
    effect: NoSchedule

args:
  - --v=2
  - --cloud-provider=aws
  - --cluster-name={{ cluster_name }}
  - --configure-cloud-routes=false
  - --controllers=*,-service,-route

resources:
  requests:
    cpu: 100m
    memory: 128Mi

  limits:
    cpu: 300m
    memory: 256Mi