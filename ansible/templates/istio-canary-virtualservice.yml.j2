---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: {{ istio_routing_service }}

spec:
  hosts:
    - {{ istio_routing_service }}

  http:
    - name: canary-traffic-split

      route:
        - destination:
            host: {{ istio_routing_service }}
            subset: v1

          weight: {{ istio_canary_v1_weight }}

        - destination:
            host: {{ istio_routing_service }}
            subset: v2

          weight: {{ istio_canary_v2_weight }}