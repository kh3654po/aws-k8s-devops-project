---
apiVersion: v1
kind: Namespace
metadata:
  name: "{{ gateway_test_namespace }}"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ gateway_test_deployment_name }}"
  namespace: "{{ gateway_test_namespace }}"
  labels:
    app: "{{ gateway_test_app_label }}"

spec:
  replicas: {{ gateway_test_replicas }}

  selector:
    matchLabels:
      app: "{{ gateway_test_app_label }}"

  template:
    metadata:
      labels:
        app: "{{ gateway_test_app_label }}"

    spec:
      containers:
        - name: nginx
          image: "{{ gateway_test_image }}"
          imagePullPolicy: IfNotPresent

          ports:
            - name: http
              containerPort: 80
              protocol: TCP

          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 3
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3

          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3

          resources:
            requests:
              cpu: 50m
              memory: 64Mi

            limits:
              cpu: 100m
              memory: 128Mi

---
apiVersion: v1
kind: Service
metadata:
  name: "{{ gateway_test_service_name }}"
  namespace: "{{ gateway_test_namespace }}"
  labels:
    app: "{{ gateway_test_app_label }}"

spec:
  type: NodePort

  selector:
    app: "{{ gateway_test_app_label }}"

  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: http

---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: "{{ gateway_test_gateway_class_name }}"

spec:
  controllerName: gateway.k8s.aws/alb

---
apiVersion: gateway.k8s.aws/v1beta1
kind: LoadBalancerConfiguration
metadata:
  name: "{{ gateway_test_load_balancer_configuration_name }}"
  namespace: "{{ gateway_test_namespace }}"

spec:
  scheme: internet-facing
  ipAddressType: ipv4

  tags:
    Project: "{{ cluster_name }}"
    ManagedBy: aws-load-balancer-controller
    Purpose: gateway-api-test

---
apiVersion: gateway.k8s.aws/v1beta1
kind: TargetGroupConfiguration
metadata:
  name: "{{ gateway_test_target_group_configuration_name }}"
  namespace: "{{ gateway_test_namespace }}"

spec:
  targetReference:
    group: ""
    kind: Service
    name: "{{ gateway_test_service_name }}"

  defaultConfiguration:
    targetType: instance
    protocol: HTTP
    protocolVersion: HTTP1

    healthCheckConfig:
      healthCheckProtocol: http
      healthCheckPath: /
      matcher:
        httpCode: "200"

---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: "{{ gateway_test_gateway_name }}"
  namespace: "{{ gateway_test_namespace }}"

spec:
  gatewayClassName: "{{ gateway_test_gateway_class_name }}"

  infrastructure:
    parametersRef:
      group: gateway.k8s.aws
      kind: LoadBalancerConfiguration
      name: "{{ gateway_test_load_balancer_configuration_name }}"

  listeners:
    - name: http
      protocol: HTTP
      port: 80

      allowedRoutes:
        namespaces:
          from: Same

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: "{{ gateway_test_http_route_name }}"
  namespace: "{{ gateway_test_namespace }}"

spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: "{{ gateway_test_gateway_name }}"
      sectionName: http

  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /

      backendRefs:
        - group: ""
          kind: Service
          name: "{{ gateway_test_service_name }}"
          port: 80
          weight: 1