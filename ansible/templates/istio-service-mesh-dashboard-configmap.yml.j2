---
apiVersion: v1
kind: ConfigMap

metadata:
  name: "{{ istio_observability_dashboard_name }}"
  namespace: "{{ monitoring_namespace }}"

  labels:
    grafana_dashboard: "1"

data:
  istio-service-mesh-dashboard.json: |-
    {
      "annotations": {
        "list": []
      },
      "editable": true,
      "graphTooltip": 1,
      "links": [],
      "panels": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 6,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "id": 1,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto"
          },
          "targets": [
            {
              "expr": "sum(rate(istio_requests_total{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\"}[5m]))",
              "legendFormat": "requests/sec",
              "refId": "A"
            }
          ],
          "title": "Mesh Request Rate",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 6,
            "w": 8,
            "x": 8,
            "y": 0
          },
          "id": 2,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto"
          },
          "targets": [
            {
              "expr": "100 * sum(rate(istio_requests_total{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\",response_code=~\"5..\"}[5m])) / clamp_min(sum(rate(istio_requests_total{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\"}[5m])), 0.001)",
              "legendFormat": "5xx %",
              "refId": "A"
            }
          ],
          "title": "Mesh 5xx Error Rate",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ms"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 6,
            "w": 8,
            "x": 16,
            "y": 0
          },
          "id": 3,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\"}[5m])) by (le, destination_workload))",
              "legendFormat": "{{ '{{' }}destination_workload{{ '}}' }}",
              "refId": "A"
            }
          ],
          "title": "P95 Request Duration",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
          },
          "id": 4,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "sum(rate(istio_requests_total{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\"}[5m])) by (destination_workload, response_code)",
              "legendFormat": "{{ '{{' }}destination_workload{{ '}}' }} - {{ '{{' }}response_code{{ '}}' }}",
              "refId": "A"
            }
          ],
          "title": "Response Codes by Workload",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 6
          },
          "id": 5,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "sum(rate(istio_requests_total{reporter=\"destination\",destination_workload_namespace=\"{{ istio_test_namespace }}\",connection_security_policy=\"mutual_tls\"}[5m])) by (destination_workload)",
              "legendFormat": "{{ '{{' }}destination_workload{{ '}}' }}",
              "refId": "A"
            }
          ],
          "title": "mTLS Request Rate",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 14
          },
          "id": 6,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "sum(rate(istio_requests_total{reporter=\"destination\",destination_service_name=\"istio-routing-demo\",destination_service_namespace=\"{{ istio_test_namespace }}\"}[5m])) by (destination_version)",
              "legendFormat": "version={{ '{{' }}destination_version{{ '}}' }}",
              "refId": "A"
            }
          ],
          "title": "Canary Traffic by Version",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 14
          },
          "id": 7,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "sum(rate(istio_requests_total{reporter=\"source\",source_workload_namespace=\"{{ istio_ingress_namespace }}\"}[5m])) by (source_workload, destination_service_name)",
              "legendFormat": "{{ '{{' }}source_workload{{ '}}' }} → {{ '{{' }}destination_service_name{{ '}}' }}",
              "refId": "A"
            }
          ],
          "title": "Ingress Gateway Traffic",
          "type": "timeseries"
        }
      ],
      "refresh": "30s",
      "schemaVersion": 39,
      "tags": [
        "istio",
        "service-mesh",
        "prometheus",
        "thanos"
      ],
      "templating": {
        "list": [
          {
            "current": {},
            "hide": 0,
            "includeAll": false,
            "label": "Prometheus / Thanos",
            "multi": false,
            "name": "datasource",
            "options": [],
            "query": "prometheus",
            "refresh": 1,
            "regex": "",
            "skipUrlSync": false,
            "type": "datasource"
          }
        ]
      },
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "timepicker": {},
      "timezone": "browser",
      "title": "Istio Service Mesh Observability",
      "uid": "istio-service-mesh",
      "version": 1
    }