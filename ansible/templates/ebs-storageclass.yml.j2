---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: "{{ ebs_storage_class_name }}"

provisioner: ebs.csi.aws.com

parameters:
  type: "{{ ebs_storage_type }}"
  encrypted: "true"

reclaimPolicy: "{{ ebs_storage_reclaim_policy }}"

allowVolumeExpansion: true

volumeBindingMode: "{{ ebs_storage_volume_binding_mode }}"